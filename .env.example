# Copy to .env; credentials stay local. Existing environment variables take precedence.
APP_ADDR=127.0.0.1:8080
DATA_DIR=.data
OPENJEV_URL=http://127.0.0.1:8089
# Defaults: mlx / openjev-latest on Apple silicon, laya / laya-1.0 elsewhere.
# OPENJEV_BACKEND=mlx
# OPENJEV_MODEL=openjev-latest
# OPENJEV_MODE=external
# OPENJEV_API_KEY=
# Register this exact redirect URL in your existing TIDAL developer application.
TIDAL_REDIRECT_URL=http://127.0.0.1:8080/tidal/callback
TIDAL_COUNTRY=US
TIDAL_CLIENT_ID=
# Only set if your developer application requires a confidential client secret.
TIDAL_CLIENT_SECRET=
